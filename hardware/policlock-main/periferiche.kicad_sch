	(text "J3: modulo breakout SHT40 commerciale (header 2,54 mm), cavo JST PH 4 poli -> jumper\nfemmina; ordine dei pin dalla serigrafia del modulo (DEC-028).\nJ4: modulo Adafruit DS3231 Precision RTC STEMMA QT (5188) con pila CR1220 (DEC-024):\ncavo JST PH 4 poli -> JST-SH (STEMMA QT) o fili sulle piazzole del modulo."
		(exclude_from_sim no)
		(at 219.71 90.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "89c2b136-9d6b-565e-a071-de5bad02c74c")
	)
	(text "IO3: risveglio da deep-sleep possibile (GPIO0-5).\nSolo pulsante remoto su J5 (DEC-032): nessun tasto USER su scheda.\nJ5 JST PH 4 poli (DEC-043): pin 1 BTN_USER, pin 2 GND, pin 3-4 non collegati."
		(exclude_from_sim no)
		(at 25.4 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
